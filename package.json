{
  "name": "@teamlearners/clawops-design-system",
  "version": "0.5.1",
  "description": "ClawOps blue glass design system for React and Next.js applications",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css && cp src/tokens.css dist/tokens.css",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "examples/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/learners-superpumped/clawops-design-system.git"
  },
  "homepage": "https://github.com/learners-superpumped/clawops-design-system#readme",
  "bugs": {
    "url": "https://github.com/learners-superpumped/clawops-design-system/issues"
  },
  "keywords": [
    "clawops",
    "design-system",
    "react",
    "nextjs",
    "glassmorphism"
  ],
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23"
  }
}
